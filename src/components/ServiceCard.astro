---
import { services } from '../content/company';
import { sitePath } from '../lib/site-path';
import Icon from './Icon.astro';

interface Props {
  service: (typeof services)[number];
}

const { service } = Astro.props;
const isEnergy = service.id === 'energy';
---
<article class="service-card">
  <img class="service-card__image" src={sitePath(`images/${service.image}`)} alt={service.alt} width="760" height="460" loading="lazy" decoding="async" />
  <div class="service-card__body">
    <span class="icon-tile"><Icon name={service.icon} /></span>
    <h3>{service.title}</h3>
    <p>{service.description}</p>
    <ul class="service-card__list">
      {service.examples.map((example) => <li>{example}</li>)}
    </ul>
    <a class="text-link" href={isEnergy ? '#modern-energy' : sitePath(`project/?service=${service.id}`)}>{service.action}</a>
  </div>
</article>
