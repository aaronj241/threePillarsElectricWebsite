---
// Renders the shared footer with the company brand, site links, and ESA licence.
import { company } from '../content/company';
import { sitePath } from '../lib/site-path';
import Brand from './Brand.astro';
---
<footer class="site-footer">
  <div class="wrap footer-inner">
    <Brand light />
    <nav aria-label="Footer navigation">
      <a href={sitePath('#services')}>Services</a>
      <a href={sitePath('#modern-energy')}>Modern Energy</a>
      <a href={sitePath('#about')}>About</a>
      <a href={sitePath('project/')}>Plan a Project</a>
    </nav>
    <p>ESA Licence #{company.licence}</p>
  </div>
</footer>
