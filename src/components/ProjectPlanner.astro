---
// Renders the project request form, validates entries, and manages its browser-only confirmation.
import { company, services } from '../content/company';
import Icon from './Icon.astro';
---
<section class="project-section" aria-labelledby="project-heading">
  <div class="wrap project-layout">
    <div class="project-copy">
      <p class="eyebrow eyebrow--light">Project planner</p>
      <h1 id="project-heading" class="project-heading">Let’s talk about<br class="desktop-break" /> your project.</h1>
      <p>Tell us what kind of electrical work you need, where the project is, and how to reach you.</p>
      {(company.contact.email || company.contact.phone) && (
        <div class="contact-links">
          {company.contact.email && <a href={`mailto:${company.contact.email}`}>{company.contact.email}</a>}
          {company.contact.phone && <a href={`tel:${company.contact.phone.replace(/[^+\d]/g, '')}`}>{company.contact.phone}</a>}
        </div>
      )}
    </div>

    {/* Reveal the form after its browser submit handler is ready. */}
    <form class="project-form" id="project-form" hidden>
      <div class="project-fields">
        {/* Name and location require a letter and support accents and common punctuation. */}
        <label for="project-name">Full name
          <input id="project-name" name="name" type="text" autocomplete="name" maxlength="100" pattern="(?=.*\p{L})[\p{L}\p{M} .'’\u002D]+" title="Use letters, spaces, periods, apostrophes, or hyphens." required />
        </label>
        <label for="project-service">Service
          <select id="project-service" name="service" required>
            <option value="" selected disabled>Select a service</option>
            {services.map(({ id, title }) => <option value={id}>{title}</option>)}
            <option value="other">Other electrical work</option>
          </select>
        </label>
        <label for="project-location">City or town
          <input id="project-location" name="location" type="text" autocomplete="address-level2" maxlength="100" pattern="(?=.*\p{L})[\p{L}\p{M} .'’\u002D]+" title="Use letters, spaces, periods, apostrophes, or hyphens." required />
        </label>
        <label for="project-email">Email
          <input id="project-email" name="email" type="email" autocomplete="email" maxlength="254" pattern="[^@]+@[^@]+\.[^@]+" title="Enter an email address such as name@example.com." required />
        </label>
        <label for="project-phone">
          <span class="field-label">Phone number <span>(optional)</span></span>
          {/* A formatted ten-digit number takes 14 characters including punctuation. */}
          <input id="project-phone" name="phone" type="tel" autocomplete="tel-national" maxlength="14" pattern="\([0-9]{3}\) [0-9]{3}-[0-9]{4}" title="Enter a 10-digit phone number." />
        </label>
      </div>
      <label for="project-description">Project description
        <textarea id="project-description" name="description" rows="4" maxlength="2000" placeholder="Describe the work you need done." required></textarea>
      </label>
      <button class="button button--lime" type="submit">Send Project Request</button>
    </form>

    <div class="request-confirmation" id="project-confirmation" role="region" tabindex="-1" aria-labelledby="request-sent-heading" aria-describedby="request-sent-message" hidden>
      <div class="request-confirmation__heading">
        <span class="request-confirmation__icon"><Icon name="check" /></span>
        <h2 id="request-sent-heading">Request Sent</h2>
      </div>
      <div class="request-confirmation__message" id="request-sent-message">
        <p>You’ll receive an email confirmation for your request shortly.</p>
        <p>You can expect a reply within 3–5 business days.</p>
      </div>
      <button class="button button--outline" id="new-project-request" type="button">Make another request</button>
    </div>
    <noscript><p>Enable JavaScript to use the project request form.</p></noscript>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#project-form');
  const service = document.querySelector<HTMLSelectElement>('#project-service');
  const nameField = document.querySelector<HTMLInputElement>('#project-name');
  const phoneField = document.querySelector<HTMLInputElement>('#project-phone');
  const description = document.querySelector<HTMLTextAreaElement>('#project-description');
  const confirmation = document.querySelector<HTMLElement>('#project-confirmation');
  const restart = document.querySelector<HTMLButtonElement>('#new-project-request');

  if (form && service && nameField && phoneField && description && confirmation && restart) {
    // A service link can prefill the menu using an existing option value.
    const projectUrl = new URL(window.location.href);
    const requestedService = projectUrl.searchParams.get('service');
    if (requestedService && Array.from(service.options).some((option) => option.value === requestedService)) {
      service.value = requestedService;
    }

    // Format as the visitor types and when the browser commits an autofilled value.
    const formatPhoneField = () => formatPhoneNumber(phoneField);
    phoneField.addEventListener('input', formatPhoneField);
    phoneField.addEventListener('change', formatPhoneField);
    formatPhoneField();
    // Clear the whitespace error when the visitor edits the field so it can be checked again.
    description.addEventListener('input', () => description.setCustomValidity(''));

    form.addEventListener('submit', (event) => {
      // Show the confirmation locally while the form has no submission or email integration.
      event.preventDefault();

      // The browser's required check accepts spaces, so also check the trimmed description.
      if (!description.value.trim()) {
        description.setCustomValidity('Describe the electrical work you need.');
        description.reportValidity();
        return;
      }

      form.hidden = true;
      confirmation.hidden = false;
      // Move focus from the hidden form to the confirmation for keyboard and screen reader users.
      confirmation.focus();
    });

    restart.addEventListener('click', () => {
      form.reset();
      // Clear the original service selection from the URL so a reload opens a blank form.
      if (projectUrl.searchParams.has('service')) {
        projectUrl.searchParams.delete('service');
        window.history.replaceState(window.history.state, '', projectUrl);
      }
      confirmation.hidden = true;
      form.hidden = false;
      nameField.focus();
    });

    form.hidden = false;
  }

  // Rebuild the display from up to ten digits for both typed and pasted input.
  function formatPhoneNumber(field: HTMLInputElement) {
    const original = field.value;
    const digits = original.replace(/\D/g, '').slice(0, 10);
    let formatted = digits;
    if (digits.length > 3) {
      formatted = '(' + digits.slice(0, 3) + ') ' + digits.slice(3, 6);
      if (digits.length > 6) formatted += '-' + digits.slice(6);
    }

    if (formatted === original) return;

    const caret = field.selectionStart;
    field.value = formatted;
    if (caret !== null && caret < original.length) {
      // Keep the caret after the same digit when punctuation shifts during an edit.
      const digitsBeforeCaret = original.slice(0, caret).replace(/\D/g, '').length;
      const digitPositions = Array.from(formatted.matchAll(/\d/g), (match) => match.index + 1);
      const position = digitPositions[Math.min(digitsBeforeCaret, digits.length) - 1] ?? 0;
      field.setSelectionRange(position, position);
    }
  }
</script>
