---
// Builds the homepage with the hero, licence summary, service cards, and company information.
import Icon from '../components/Icon.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { company, energyServices, services, values } from '../content/company';
import SiteLayout from '../layouts/SiteLayout.astro';
import { sitePath } from '../lib/site-path';
---
<SiteLayout
  title="Three Pillar Electric | Residential & Commercial Electrical Services"
  description="Three Pillar Electric provides residential and commercial electrical services, panel upgrades, EV charging, and solar electrical integration."
>
  <main id="main" tabindex="-1">
    <div class="home-intro">
      <section class="hero" aria-labelledby="hero-heading">
        {/* The browser chooses a hero image size using the same breakpoint as the layout. */}
        <img
          class="hero__image"
          src={sitePath('images/electrical-panel-work.webp')}
          srcset={`${sitePath('images/electrical-panel-work-small.webp')} 560w, ${sitePath('images/electrical-panel-work.webp')} 941w`}
          sizes="(max-width: 700px) 100vw, 54vw"
          alt="An electrician working on wiring inside an electrical panel"
          width="941"
          height="1672"
          fetchpriority="high"
        />
        <div class="wrap hero__inner">
          <div class="hero__content">
            <p class="eyebrow eyebrow--light">Residential & commercial electrical</p>
            <h1 id="hero-heading">Electrical work. <em>Done right.</em></h1>
            <p class="hero__description">From everyday repairs to major installations, we help homeowners and businesses get the power they need today and prepare for what’s next.</p>
            <div class="hero__actions">
              <a class="button button--lime" href={sitePath('project/')}>Plan a Project</a>
              <a class="button button--outline" href="#services">Explore Services</a>
            </div>
          </div>
        </div>
      </section>

      <div class="qualification-band">
        <ul class="wrap qualification-list" aria-label="Licence and areas of work">
          <li><Icon name="shield" /> <span>ESA Licence <strong>#{company.licence}</strong></span></li>
          <li><Icon name="building" /> <span>Residential & Commercial</span></li>
          <li><Icon name="bolt" /> <span>EV Charging & Solar</span></li>
        </ul>
      </div>
    </div>

    {/* Homepage section IDs are navigation targets. The negative tabindex lets navigation move focus to them. */}
    <section class="services-section section-space" id="services" tabindex="-1" aria-labelledby="services-heading">
      <div class="wrap">
        <div class="section-heading">
          <p class="eyebrow">Our services</p>
          <h2 id="services-heading">Power for every project.</h2>
          <p>Electrical installations, repairs, and upgrades for homes, businesses, and properties preparing for new energy demands.</p>
        </div>
        <div class="services-grid">
          {services.map((service) => <ServiceCard service={service} />)}
        </div>
      </div>
    </section>

    <section class="energy-section section-space" id="modern-energy" tabindex="-1" aria-labelledby="energy-heading">
      <div class="wrap energy-layout">
        <figure class="energy-photo">
          <img src={sitePath('images/rooftop-solar.webp')} alt="Solar panels installed on residential rooftops" width="1100" height="940" loading="lazy" decoding="async" />
        </figure>
        <div class="energy-copy">
          <p class="eyebrow">Modern energy</p>
          <h2 id="energy-heading">Make room for<br class="desktop-break" /> what’s next.</h2>
          <p>Find out what your electrical system can support today and where an upgrade could make a difference.</p>
          <ul class="energy-list">
            {energyServices.map((service) => (
              <li>
                <span class="icon-tile"><Icon name={service.icon} /></span>
                <div>
                  <h3>{service.title}</h3>
                  <p>{service.description}</p>
                </div>
              </li>
            ))}
          </ul>
          {/* The service query selects EV and Solar when the project form opens. */}
          <a class="button button--dark" href={sitePath('project/?service=energy')}>Plan an Energy Upgrade</a>
        </div>
      </div>
    </section>

    <section class="about-section section-space" id="about" tabindex="-1" aria-labelledby="about-heading">
      <div class="wrap">
        <div class="section-heading">
          <p class="eyebrow">About us</p>
          <h2 id="about-heading">How we work.</h2>
          <p>Three Pillar Electric works with homeowners, businesses, property managers, and contractors to plan and complete electrical work.</p>
        </div>
        <div class="values-grid">
          {values.map((value) => (
            <article class="value">
              <span class="icon-tile"><Icon name={value.icon} /></span>
              <h3>{value.title}</h3>
              <p>{value.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</SiteLayout>
